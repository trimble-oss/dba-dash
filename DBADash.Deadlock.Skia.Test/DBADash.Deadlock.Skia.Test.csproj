<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <StartupObject></StartupObject>
    <Configurations>Debug;Release;CLI</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBADash.Deadlock.Skia\DBADash.Deadlock.Skia.csproj" />
  </ItemGroup>

  <!--
    The sample graphs are shared with the core library's tests rather than duplicated, so both
    suites exercise the same inputs and there is one place to add a new sample.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\DBADash.Deadlock.Test\Graphs\*.xdl" LogicalName="Graphs.%(Filename).xdl" />
  </ItemGroup>

</Project>
