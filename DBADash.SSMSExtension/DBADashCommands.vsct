<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidDBADashPackage">
    <Groups>
      <!-- Parented to SSMS's own execution plan right-click context menu. -->
      <Group guid="guidDBADashCmdSet" id="ContextMenuGroupId" priority="0x0600">
        <Parent guid="guidShowPlanContextMenu" id="ShowPlanContextMenuId"/>
      </Group>

      <!-- Parented to SSMS's results grid right-click context menu. -->
      <Group guid="guidDBADashCmdSet" id="ResultsGridContextMenuGroupId" priority="0x0600">
        <Parent guid="guidShowPlanContextMenu" id="ResultsGridContextMenuId"/>
      </Group>

      <!--
        The same command also lives on the Tools menu, since the deadlock graph has no native context
        menu to rely on at all (see DeadlockContextMenuHook). OpenCommand's own BeforeQueryStatus hides it here whenever nothing it
        can read is focused, so this doesn't just sit there listing an option that would do nothing.
      -->
      <Group guid="guidDBADashCmdSet" id="ToolsGroupId" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDBADashCmdSet" id="OpenCommandId" priority="0x0100" type="Button">
        <Parent guid="guidDBADashCmdSet" id="ContextMenuGroupId"/>
        <Icon guid="guidDBADashImages" id="bmpDBADash"/>
        <Strings>
          <ButtonText>Open in DBA Dash Visualizer</ButtonText>
        </Strings>
      </Button>

      <!--
        Every result set in the query window at once (OpenAllResultsCommand). DynamicVisibility and DefaultInvisible
        so it only appears once its BeforeQueryStatus has found more than one results grid.
      -->
      <Button guid="guidDBADashCmdSet" id="OpenAllResultsCommandId" priority="0x0101" type="Button">
        <Parent guid="guidDBADashCmdSet" id="ResultsGridContextMenuGroupId"/>
        <Icon guid="guidDBADashImages" id="bmpDBADash"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Open All Results in DBA Dash Visualizer</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidDBADashImages" href="Resources\DBADashIcon.png" usedList="bmpDBADash"/>
    </Bitmaps>
  </Commands>

  <CommandPlacements>
    <!-- The same OpenCommandId button as above, additionally placed on the Tools menu group. -->
    <CommandPlacement guid="guidDBADashCmdSet" id="OpenCommandId" priority="0x0110">
      <Parent guid="guidDBADashCmdSet" id="ToolsGroupId"/>
    </CommandPlacement>
    <!-- ...and on the results grid's right-click menu. -->
    <CommandPlacement guid="guidDBADashCmdSet" id="OpenCommandId" priority="0x0100">
      <Parent guid="guidDBADashCmdSet" id="ResultsGridContextMenuGroupId"/>
    </CommandPlacement>
    <!-- Open All Results on the Tools menu too, just below Open. -->
    <CommandPlacement guid="guidDBADashCmdSet" id="OpenAllResultsCommandId" priority="0x0111">
      <Parent guid="guidDBADashCmdSet" id="ToolsGroupId"/>
    </CommandPlacement>
  </CommandPlacements>

  <!--
    No right-click for a plain XML tab (e.g. sp_BlitzLock's deadlock output): IDM_VS_CTXT_CODEWIN, the
    standard code editor context menu, didn't merge into it, and neither did attaching a WinForms/WPF
    context menu directly to the view's window - a real native context menu does appear there, so this
    viewer is most likely a COM-hosted editor that renders its own menu outside either mechanism.
    Reaching it would need an IOleCommandTarget command filter (IVsTextView.AddCommandFilter) and its
    own undiscoverable menu GUID - not attempted, since the Tools menu and the Ctrl+Alt+Shift+D
    keybinding already cover this case reliably.
  -->

  <KeyBindings>
    <!--
      A keybinding invokes a command directly through the shell's command table, independent of
      whether any menu placement actually rendered - useful since IDM_VS_MENU_TOOLS's group placement
      above is unconfirmed in SSMS specifically (unlike guidShowPlanContextMenu, which is known to
      work). Chosen to avoid colliding with SSMS's own common shortcuts.
    -->
    <KeyBinding guid="guidDBADashCmdSet" id="OpenCommandId" editor="guidVSStd97" key1="D" mod1="Control Alt Shift"/>
  </KeyBindings>

  <Symbols>
    <!-- Package GUID -->
    <GuidSymbol name="guidDBADashPackage" value="{00F620C6-2F07-4202-9D64-92AECB958CFB}" />

    <!-- Command set GUID -->
    <GuidSymbol name="guidDBADashCmdSet" value="{0CC07265-7442-475F-99F3-41177ED25148}">
      <IDSymbol name="ContextMenuGroupId" value="0x1020"/>
      <IDSymbol name="OpenCommandId" value="0x0100"/>
      <IDSymbol name="OpenAllResultsCommandId" value="0x0101"/>
      <IDSymbol name="ToolsGroupId" value="0x1030"/>
      <IDSymbol name="ResultsGridContextMenuGroupId" value="0x1040"/>
    </GuidSymbol>

    <!--
      SSMS's execution plan right-click context menu. Not something we defined: a fact about SSMS
      itself, publicly documented (e.g. erikdarlingdata/PerformanceStudio's AnalyzePlanPackage.vsct,
      whose own comment notes it is confirmed the same across SSMS 18-22). Reused as data, not code.

      The results grid's right-click menu is in the same group: SQLEditors.dll's SQLWorkbenchCommands
      names this GUID GUID_SQLEditorGroup, with IDM_SQLWB_EXECPLAN_CONTEXT = 0x0080 and
      IDM_SQLWB_SQLRESGRID_CONTEXT = 0x0070 - the ID DisplaySqlResultsTabControl.WndProc shows on
      WM_CONTEXTMENU over a grid (confirmed against the SSMS 22 install).
    -->
    <GuidSymbol name="guidShowPlanContextMenu" value="{33F13AC3-80BB-4ECB-85BC-225435603A5E}">
      <IDSymbol name="ShowPlanContextMenuId" value="0x0080"/>
      <IDSymbol name="ResultsGridContextMenuId" value="0x0070"/>
    </GuidSymbol>

    <!-- The DBA Dash app icon, extracted 16x16 from Assets/DBADash.ico. -->
    <GuidSymbol name="guidDBADashImages" value="{5A9E9F2E-6B7C-4A1E-9E3D-8F2C1B4A6D7E}">
      <IDSymbol name="bmpDBADash" value="1"/>
    </GuidSymbol>
  </Symbols>
</CommandTable>
