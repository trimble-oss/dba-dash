<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release;CLI</Configurations>
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <!--
      The query plan and deadlock viewers, as controls and windows.  Everything here has to work with no DBA Dash
      repository and no monitored instance - a plan or deadlock graph someone emailed you opens the same as one from a
      report - so this project references DBADashSharedGUI and the viewer model / rendering libraries, and never DBADash
      or DBADashGUI.  What the viewers can do only when they know where the artifact came from (AI analysis, collecting
      the current plan from the instance, the Query Store lookup) is offered by the host through IViewerHost.
    -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DBADashSharedGUI" />
    <Using Include="DBADash.Viewers.GUI.Properties.Resources" Alias="Resources" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Setup.Configuration.Interop" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBADash.Deadlock\DBADash.Deadlock.csproj" />
    <ProjectReference Include="..\DBADash.Deadlock.Skia\DBADash.Deadlock.Skia.csproj" />
    <ProjectReference Include="..\DBADash.QueryPlan\DBADash.QueryPlan.csproj" />
    <ProjectReference Include="..\DBADash.QueryPlan.Skia\DBADash.QueryPlan.Skia.csproj" />
    <ProjectReference Include="..\DBADashCommon\DBADashCommon.csproj" />
    <ProjectReference Include="..\DBADashSharedGUI\DBADashSharedGUI.csproj" />

    <!--
      Build-order only - DBADash.SSMSExtension is net472 (a hard VSSDK requirement) and can't be
      referenced as an assembly from this net10 project. This just makes sure it's been built before
      the EmbeddedResource below looks for its .vsix output.
    -->
    <ProjectReference Include="..\DBADash.SSMSExtension\DBADash.SSMSExtension.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    Embeds the SSMS extension so SsmsExtensionInstaller can offer it from the settings menu without a
    separate download - present whenever DBADash.SSMSExtension has been built for the same
    configuration, absent otherwise (a local dev build of just this project still works fine; the
    installer option simply doesn't show up).  The extension itself ships on its own cadence
    (Scripts/Pack-SSMSExtension.ps1) - embedding the code as built here is a separate concern from
    when a new version of it gets released.

    A Target rather than a plain ItemGroup: a plain Condition="Exists(...)" item is evaluated once, up
    front, before any target - including the one that builds the ProjectReference above - has run, so on
    a clean build it would always see the .vsix as missing even though the reference is about to produce
    it. Runs before AssignTargetPaths - the point resource generation itself reads @(EmbeddedResource)
    from, confirmed the hard way: adding the item at BeforeBuild logged correctly but the resource still
    didn't make it into the built DLL, since CoreResGen had already run by then - and after
    ResolveProjectReferences, so the .vsix this looks for actually exists by the time this runs.

    The .vsix path is asked of the extension project itself (its VSIXContainerProjectOutputGroup, with
    the same properties ResolveProjectReferences built it with) rather than assumed to be
    bin\$(Configuration)\net472: the solution maps this project's CLI configuration to a different one
    for the extension, and -o redirects its output entirely - either way the guessed path didn't exist
    and the resource was silently left out of the release build.
  -->
  <Target Name="AddSsmsExtensionVsixResource" BeforeTargets="AssignTargetPaths" AfterTargets="ResolveProjectReferences">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="VSIXContainerProjectOutputGroup"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.Filename)' == 'DBADash.SSMSExtension'">
      <Output TaskParameter="TargetOutputs" ItemName="_SsmsExtensionVsix" />
    </MSBuild>

    <Warning Text="SSMS extension .vsix not found (@(_SsmsExtensionVsix)) - the Install SSMS Extension option won't be offered by this build."
             Condition="'$(DesignTimeBuild)' != 'true' and ('@(_SsmsExtensionVsix)' == '' or !Exists('@(_SsmsExtensionVsix)'))" />

    <ItemGroup>
      <EmbeddedResource Include="@(_SsmsExtensionVsix)" Condition="Exists('@(_SsmsExtensionVsix)')">
        <LogicalName>DBADash.SSMSExtension.vsix</LogicalName>
        <Link>Resources\DBADash.SSMSExtension.vsix</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
